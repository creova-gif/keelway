{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/favicon.ico",
      "destination": "/favicon.svg",
      "statusCode": 308,
      "regex": "^(?!/_next)/favicon\\.ico(?:/)?$"
    },
    {
      "source": "/playground",
      "destination": "/",
      "statusCode": 308,
      "regex": "^(?!/_next)/playground(?:/)?$"
    },
    {
      "source": "/index.html",
      "destination": "/",
      "statusCode": 308,
      "regex": "^(?!/_next)/index\\.html(?:/)?$"
    },
    {
      "source": "/docs.html",
      "destination": "/docs",
      "statusCode": 308,
      "regex": "^(?!/_next)/docs\\.html(?:/)?$"
    },
    {
      "source": "/releases",
      "destination": "/changelog",
      "statusCode": 308,
      "regex": "^(?!/_next)/releases(?:/)?$"
    },
    {
      "source": "/api.html",
      "destination": "/product",
      "statusCode": 308,
      "regex": "^(?!/_next)/api\\.html(?:/)?$"
    },
    {
      "source": "/brand.html",
      "destination": "/about",
      "statusCode": 308,
      "regex": "^(?!/_next)/brand\\.html(?:/)?$"
    },
    {
      "source": "/repo/issues/:path*",
      "destination": "https://github.com/creova-gif/keelway/issues/:path*",
      "statusCode": 307,
      "regex": "^(?!/_next)/repo/issues(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    },
    {
      "source": "/repo",
      "destination": "https://github.com/creova-gif/keelway",
      "statusCode": 307,
      "regex": "^(?!/_next)/repo(?:/)?$"
    },
    {
      "source": "/repo/:path*",
      "destination": "https://github.com/creova-gif/keelway/blob/main/:path*",
      "statusCode": 307,
      "regex": "^(?!/_next)/repo(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ],
      "regex": "^(?:/(.*))(?:/)?$"
    }
  ],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/.well-known/vercel/flags",
      "regex": "^/\\.well\\-known/vercel/flags(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/\\.well\\-known/vercel/flags(?:/)?$"
    },
    {
      "page": "/about",
      "regex": "^/about(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/about(?:/)?$"
    },
    {
      "page": "/changelog",
      "regex": "^/changelog(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/changelog(?:/)?$"
    },
    {
      "page": "/contact",
      "regex": "^/contact(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/contact(?:/)?$"
    },
    {
      "page": "/docs",
      "regex": "^/docs(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/docs(?:/)?$"
    },
    {
      "page": "/feed.xml",
      "regex": "^/feed\\.xml(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/feed\\.xml(?:/)?$"
    },
    {
      "page": "/legal",
      "regex": "^/legal(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/legal(?:/)?$"
    },
    {
      "page": "/manifest.webmanifest",
      "regex": "^/manifest\\.webmanifest(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/manifest\\.webmanifest(?:/)?$"
    },
    {
      "page": "/pricing",
      "regex": "^/pricing(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/pricing(?:/)?$"
    },
    {
      "page": "/product",
      "regex": "^/product(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/product(?:/)?$"
    },
    {
      "page": "/robots.txt",
      "regex": "^/robots\\.txt(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/robots\\.txt(?:/)?$"
    },
    {
      "page": "/sign-in",
      "regex": "^/sign\\-in(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/sign\\-in(?:/)?$"
    },
    {
      "page": "/sitemap.xml",
      "regex": "^/sitemap\\.xml(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/sitemap\\.xml(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}