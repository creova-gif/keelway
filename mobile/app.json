{
  "expo": {
    "name": "Keelway Mobile",
    "slug": "keelway-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "keelway",
    "splash": {
      "backgroundColor": "#070A12"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.keelway.mobile",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Keelway requires FaceID to cryptographically authorize agent code commits and spend mandates."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#070A12"
      },
      "package": "dev.keelway.mobile",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "INTERNET"
      ]
    }
  }
}
