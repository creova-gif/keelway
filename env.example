# Environment variables — copy to .env and fill values
# Never commit the real .env

# Model providers — configure one or more
# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# NVIDIA
NVIDIA_API_KEY=
NVIDIA_MODEL=

# Local / open-weight (example)
LOCAL_MODEL_BASE_URL=http://localhost:11434
LOCAL_MODEL_NAME=qwen2.5:7b

# Routing defaults
DEFAULT_MODEL_PROVIDER=anthropic
DEFAULT_MODEL=claude-sonnet-4-20250514

# Database
# Default (unset): sqlite+aiosqlite:///~/.keelway/keelway.db
# PostgreSQL requires the asyncpg driver: pip install -e ".[postgres]"
#DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/keelway

# Auth
# API tokens are required unless AUTH_REQUIRED=false. KEELWAY_API_TOKEN pins the owner launch token printed by `keelway dev`.
AUTH_REQUIRED=true
KEELWAY_API_TOKEN=
AUTH_SECRET=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# docker-compose.yml control-plane: signs policy/audit records. Generate with
# `openssl rand -hex 32`; required to bring the compose stack up.
KEELWAY_POLICY_SIGNING_KEY=

# GitHub (read-only initially)
GITHUB_TOKEN=

# Google Cloud (if using client libraries)
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=

# Extra browser origins (comma-separated) allowed to call the API besides the Studio itself, e.g. an Expo web dev server
ALLOWED_ORIGINS=

# Marketplace first-party manifest signing (Ed25519). First-party packages are
# left unsigned (verification fails closed) until one of these is configured.
# Preferred: a key file that is loaded or generated once with mode 0600.
#KEELWAY_MANIFEST_KEY_FILE=
# Or set KEELWAY_STATE_DIR and the key file defaults to $KEELWAY_STATE_DIR/manifest-signing.seed
#KEELWAY_STATE_DIR=
# Or inject key material directly (PKCS#8 PEM or 32-byte hex/base64 seed):
#KEELWAY_MANIFEST_SIGNING_KEY=
#KEELWAY_MANIFEST_SIGNING_SEED=
# Local development/tests only — deterministic well-known key, NEVER in production:
#KEELWAY_DEV_INSECURE_KEY=1

# Simulated multi-rail payment broker (M-Pesa/PIX/UPI/L402/voucher). No provider
# is connected; intents are refused until a non-default secret is configured.
#KEELWAY_PAYMENT_BROKER_SECRET=
